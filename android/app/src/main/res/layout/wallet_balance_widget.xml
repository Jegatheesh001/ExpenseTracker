<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wallet_balance_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wallet balance"
        android:textColor="#FF1B1B1F"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/wallet_balance_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0 AED"
        android:textColor="#FF00695C"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wallet_balance_breakdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0 cash • 0 bank"
        android:textColor="#FF45464F"
        android:textSize="14sp" />
</LinearLayout>
